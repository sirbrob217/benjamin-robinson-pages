{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sirbrob217.github.io/benjamin-robinson-pages/schema/commands.schema.json",
  "title": "Ulfgar Bot public command documentation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_from", "server_aliases", "commands"],
  "properties": {
    "schema_version": { "const": 1 },
    "generated_from": { "type": "string", "minLength": 1, "maxLength": 100 },
    "server_aliases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/serverAlias" }
    },
    "commands": {
      "type": "array",
      "items": { "$ref": "#/$defs/command" }
    }
  },
  "$defs": {
    "serverAlias": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "alias", "icon"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "alias": { "type": "string", "minLength": 1 },
        "icon": { "type": "string", "pattern": "^assets/servers/[a-z0-9.-]+$" }
      }
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "value": { "type": ["string", "integer", "number", "boolean"] }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "type", "required"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "choices": {
          "type": "array",
          "items": { "$ref": "#/$defs/choice" }
        },
        "min_value": { "type": ["integer", "number"] },
        "max_value": { "type": ["integer", "number"] },
        "min_length": { "type": "integer", "minimum": 0 },
        "max_length": { "type": "integer", "minimum": 1 }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "name",
        "category",
        "description",
        "permission",
        "availability",
        "server_keys",
        "type",
        "options",
        "subcommands"
      ],
      "properties": {
        "path": { "type": "string", "pattern": "^[A-Za-z0-9_ -]+(?:/[A-Za-z0-9_ -]+)?$" },
        "name": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "details": { "type": "string", "minLength": 1 },
        "permission": { "enum": ["user", "admin", "mixed"] },
        "availability": { "type": "string", "minLength": 1 },
        "server_keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
        },
        "type": { "enum": ["chat_input", "message", "user"] },
        "options": {
          "type": "array",
          "items": { "$ref": "#/$defs/option" }
        },
        "subcommands": {
          "type": "array",
          "items": { "$ref": "#/$defs/command" }
        }
      }
    }
  }
}
