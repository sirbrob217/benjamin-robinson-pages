{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sirbrob217.github.io/benjamin-robinson-pages/schema/features.schema.json",
  "title": "Ulfgar Bot public automatic-feature documentation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_from", "features"],
  "properties": {
    "schema_version": { "const": 1 },
    "generated_from": { "type": "string", "minLength": 1, "maxLength": 100 },
    "features": {
      "type": "array",
      "items": { "$ref": "#/$defs/feature" }
    }
  },
  "$defs": {
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name", "category", "description", "details", "availability", "server_keys"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "details": { "type": "string", "minLength": 1 },
        "availability": { "type": "string", "minLength": 1 },
        "server_keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
        }
      }
    }
  }
}
